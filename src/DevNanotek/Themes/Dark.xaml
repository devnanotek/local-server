<!-- DEVNANOTEK gece paleti — devnanotek.net [data-theme=dark] değişkenlerinden türetildi -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Bg">#1B1C1D</Color>
    <Color x:Key="C.Surface">#232425</Color>
    <Color x:Key="C.Surface2">#2A2B2D</Color>
    <Color x:Key="C.Surface3">#333436</Color>
    <Color x:Key="C.Sidebar">#161718</Color>
    <Color x:Key="C.SidebarLine">#2A2B2D</Color>
    <Color x:Key="C.Line">#333436</Color>
    <Color x:Key="C.LineStrong">#4A4B4E</Color>
    <Color x:Key="C.Text">#F2EFE8</Color>
    <Color x:Key="C.Muted">#A49B8C</Color>
    <Color x:Key="C.Accent">#FAA41A</Color>
    <Color x:Key="C.AccentHover">#FFB43A</Color>
    <Color x:Key="C.AccentInk">#2A1C06</Color>
    <Color x:Key="C.AccentText">#FFB43A</Color>
    <Color x:Key="C.AccentSoft">#3A2F1C</Color>
    <Color x:Key="C.Ok">#3DD68C</Color>
    <Color x:Key="C.OkBg">#1F3A2D</Color>
    <Color x:Key="C.Err">#FF6B6B</Color>
    <Color x:Key="C.ErrBg">#3D2427</Color>
    <Color x:Key="C.Warn">#FFC14D</Color>
    <Color x:Key="C.WarnBg">#3A3220</Color>
    <Color x:Key="C.Info">#6BB6FF</Color>
    <Color x:Key="C.InfoBg">#1E2F42</Color>
    <Color x:Key="C.Input">#1F2021</Color>
    <Color x:Key="C.Hover">#2D2E30</Color>
    <Color x:Key="C.Header">#111213</Color>
    <Color x:Key="C.HeaderText">#F2EFE8</Color>
    <Color x:Key="C.HeaderMuted">#A49B8C</Color>
    <Color x:Key="C.Selection">#5A4520</Color>
    <Color x:Key="C.CodeBg">#141516</Color>
    <Color x:Key="C.CodeText">#E8E4DB</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource C.Surface2}"/>
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource C.Surface3}"/>
    <SolidColorBrush x:Key="Sidebar" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="SidebarLine" Color="{StaticResource C.SidebarLine}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource C.LineStrong}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource C.AccentHover}"/>
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource C.AccentInk}"/>
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource C.AccentText}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource C.AccentSoft}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="OkBg" Color="{StaticResource C.OkBg}"/>
    <SolidColorBrush x:Key="Err" Color="{StaticResource C.Err}"/>
    <SolidColorBrush x:Key="ErrBg" Color="{StaticResource C.ErrBg}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="WarnBg" Color="{StaticResource C.WarnBg}"/>
    <SolidColorBrush x:Key="Info" Color="{StaticResource C.Info}"/>
    <SolidColorBrush x:Key="InfoBg" Color="{StaticResource C.InfoBg}"/>
    <SolidColorBrush x:Key="Input" Color="{StaticResource C.Input}"/>
    <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}"/>
    <SolidColorBrush x:Key="Header" Color="{StaticResource C.Header}"/>
    <SolidColorBrush x:Key="HeaderText" Color="{StaticResource C.HeaderText}"/>
    <SolidColorBrush x:Key="HeaderMuted" Color="{StaticResource C.HeaderMuted}"/>
    <SolidColorBrush x:Key="Selection" Color="{StaticResource C.Selection}"/>
    <SolidColorBrush x:Key="CodeBg" Color="{StaticResource C.CodeBg}"/>
    <SolidColorBrush x:Key="CodeText" Color="{StaticResource C.CodeText}"/>
</ResourceDictionary>
