<local:ViewBase x:Class="DevNanotek.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DevNanotek.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,8" MaxWidth="1100">
            <!-- Başlık -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="MainToggle" Style="{StaticResource Primary}" Padding="18,8" Click="MainToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MainToggleIcon" Style="{StaticResource Icon}" FontSize="13" Text="&#xE768;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MainToggleText" Text="Başlat" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Tümünü yeniden başlat" Click="RestartAll_Click"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE90F;" ToolTip="Onar / Sıfırla" Click="Reset_Click" Margin="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Genel Bakış"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource MutedText}" Text="Durum alınıyor…" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Akıllı Uygulama Denetimi uyarısı -->
            <Border x:Name="SacBanner" Visibility="Collapsed" Background="{DynamicResource ErrBg}" BorderBrush="{DynamicResource Err}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Nasıl kapatılır?" Click="SacInfo_Click" Margin="0"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Err}" Margin="0,0,10,0"/>
                    <TextBlock Foreground="{DynamicResource Err}" VerticalAlignment="Center" Text="Windows 'Akıllı Uygulama Denetimi' açık; sunucu bileşenlerini engelleyebilir."/>
                </DockPanel>
            </Border>

            <!-- Durum kartı -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <CheckBox x:Name="ModeSwitch" Style="{StaticResource Switch}" Content="Bilgisayar açılınca başlat" Checked="Mode_Changed" Unchecked="Mode_Changed"/>
                            <local:InfoTip x:Name="ModeTip"/>
                        </StackPanel>
                        <Ellipse x:Name="OverallDot" Width="14" Height="14" Margin="0,4,12,0" VerticalAlignment="Top" Fill="{DynamicResource Muted}"/>
                        <StackPanel>
                            <TextBlock x:Name="OverallText" Style="{StaticResource H2}" FontSize="17" Text="…"/>
                            <TextBlock x:Name="VersionsLine" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource Small}" Click="OpenLocalhost_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE774;" Margin="0,0,7,0"/><TextBlock Text="localhost"/></StackPanel></Button>
                        <Button x:Name="HttpsBtn" Style="{StaticResource Small}" Click="OpenHttps_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72E;" Margin="0,0,7,0"/><TextBlock Text="https"/></StackPanel></Button>
                        <Button Style="{StaticResource Small}" Click="Pma_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE1D3;" Margin="0,0,7,0"/><TextBlock Text="phpMyAdmin"/></StackPanel></Button>
                        <Button x:Name="AdminerBtn" Style="{StaticResource Small}" Click="Adminer_Click" ToolTip="Tüm veritabanları: MySQL/MariaDB, PostgreSQL, SQLite, SQL Server"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8F1;" Margin="0,0,7,0"/><TextBlock Text="Adminer"/></StackPanel></Button>
                        <Button x:Name="MailBtn" Style="{StaticResource Small}" Click="MailUi_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE715;" Margin="0,0,7,0"/><TextBlock Text="Mailpit"/></StackPanel></Button>
                        <Button Style="{StaticResource Small}" Click="OpenDocroot_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8B7;" Margin="0,0,7,0"/><TextBlock Text="httpdocs"/></StackPanel></Button>
                        <Button Style="{StaticResource Small}" Click="Terminal_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE756;" Margin="0,0,7,0"/><TextBlock Text="Terminal"/></StackPanel></Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Servisler -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="UpdateChip" DockPanel.Dock="Right" Style="{StaticResource Link}" Visibility="Collapsed" Click="Updates_Click"/>
                        <TextBlock Style="{StaticResource Caption}" Text="SERVİSLER" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="ServiceRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Row.Level, Converter={StaticResource LevelBrush}}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Row.TitleWithVersion}" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                <local:InfoTip Text="{Binding Info}"/>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource Muted}">
                                                <Run Text="{Binding Row.State, Mode=OneWay}" Foreground="{Binding Row.Level, Converter={StaticResource LevelBrush}, Mode=OneWay}"/><Run Text="{Binding Ports, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Small}" Tag="{Binding}" Click="RowToggle_Click" Content="{Binding ActionText}" MinWidth="76"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE9F9;" ToolTip="Günlük" Tag="{Binding}" Click="RowLog_Click"/>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="Ayarlar" Tag="{Binding}" Click="RowSettings_Click" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sürümler -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Tüm sürümler →" Click="Versions_Click"/>
                        <TextBlock Style="{StaticResource Caption}" Text="AKTİF SÜRÜMLER" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PHP" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Text}"/>
                        <ComboBox x:Name="PhpCombo" Grid.Column="1"/>
                        <Button Grid.Column="2" Style="{StaticResource Small}" Content="Geç" Margin="8,0,0,0" Click="PhpSwitch_Click"/>
                        <TextBlock Grid.Column="4" Text="Node.js" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Text}"/>
                        <ComboBox x:Name="NodeCombo" Grid.Column="5"/>
                        <Button Grid.Column="6" Style="{StaticResource Small}" Content="Geç" Margin="8,0,0,0" Click="NodeSwitch_Click"/>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <ItemsControl x:Name="VersionChips">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Text}"/></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ExtLink" Style="{StaticResource Link}" Content="Eklentiler (gd, zip…)" Click="ExtOpen_Click" Margin="4,0,0,6" ToolTip="Sık kullanılan PHP eklentilerini aç / kapat"/>
                        <Button Style="{StaticResource Link}" Content="php.ini" Click="PhpIni_Click" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource Link}" Content="phpinfo()" Click="PhpInfo_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <!-- Eklenti açılır penceresi -->
                    <Popup x:Name="ExtPopup" PlacementTarget="{Binding ElementName=ExtLink}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14" Margin="8,4,12,14" Width="480">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="#000000"/></Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="Kapat" Click="ExtClose_Click" Margin="0"/>
                                    <TextBlock x:Name="ExtTitle" Style="{StaticResource H2}" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                                <local:PhpExtSwitches x:Name="ExtSwitches" ItemWidth="215"/>
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Kaydet ve uygula" Click="ExtSave_Click" Margin="0"/>
                                    <Button Style="{StaticResource Link}" Content="Tüm eklentiler →" Click="ExtAll_Click" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:ViewBase>
