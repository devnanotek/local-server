<local:ViewBase x:Class="DevNanotek.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DevNanotek.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,16" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" VerticalAlignment="Center" Click="OpenGuide_Click" Margin="0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE736;" Margin="0,0,8,0"/><TextBlock Text="Tam kılavuz"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Yardım"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="En sık sorulanlar. Ayrıntılı anlatım için Tam kılavuz." Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="Faq">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Q}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding A}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Linux sürümü -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Linux sürümünü al" Click="Linux_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE756;" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Linux'ta da kullanmak ister misiniz?" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Text}"/>
                        <TextBlock Foreground="{DynamicResource Muted}" Margin="0,4,0,0" Text="Ubuntu, Debian, Linux Mint, AlmaLinux, Rocky, RHEL ve Fedora için aynı ortamı kuran devnanotek.sh betiği. Dosyayı Linux bilgisayara kopyalayıp 'sudo bash devnanotek.sh install' çalıştırın."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <WrapPanel Margin="0,6,0,0">
                <Button Style="{StaticResource Small}" Content="Kılavuz klasörü" Click="OpenDocsFolder_Click"/>
                <Button Style="{StaticResource Small}" Content="Program günlüğü" Click="OpenLog_Click"/>
                <Button Style="{StaticResource Small}" Content="GitHub (açık kaynak)" Click="OpenGitHub_Click" ToolTip="Kaynak kod, sürümler ve hata bildirimi"/>
                <Button Style="{StaticResource Small}" Content="Hata bildir / öneri" Click="OpenIssues_Click"/>
                <Button Style="{StaticResource Small}" Content="Proje sitesi" Click="OpenPages_Click"/>
                <Button Style="{StaticResource Small}" Content="devnanotek.net" Click="OpenSite_Click"/>
            </WrapPanel>
            <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
        </StackPanel>
    </ScrollViewer>
</local:ViewBase>
