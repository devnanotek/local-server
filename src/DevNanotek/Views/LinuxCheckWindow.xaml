<Window x:Class="DevNanotek.Views.LinuxCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevNanotek.Views"
        Title="DEVNANOTEK — Linux uyumluluk denetimi" Height="680" Width="900" MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        Icon="pack://application:,,,/Assets/devnanotek.ico" FontFamily="{StaticResource FontUI}" FontSize="13.5" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Header}" Padding="24,18">
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="10" Background="#232425" BorderBrush="#3A3B3D" BorderThickness="1" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" FontSize="18" Foreground="#FAA41A" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Linux uyumluluk denetimi" Foreground="{DynamicResource HeaderText}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RootText" Foreground="{DynamicResource HeaderMuted}" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Özet -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,16,24,8" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="CbShowInfo" Content="Bilgileri göster" IsChecked="False" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>
                    <local:InfoTip Text="Neler denetlenir?&#10;• include/require ve resim/css/js bağlantılarında büyük/küçük harf uyumsuzluğu (Windows'ta çalışır, Linux'ta 404 / dosya bulunamadı)&#10;• Yollarda ters bölü (\) ve C:\ gibi Windows yolları&#10;• Sınıf adı ile dosya adının harf uyumsuzluğu (Composer autoload)&#10;• Karışık harfli tablo adları (MySQL Linux'ta harf duyarlı)&#10;• .htaccess'te php_value (PHP-FPM'de 500 hatası)&#10;• CRLF satır sonlu .sh betikleri, Windows komutları, COM nesneleri&#10;• Türkçe karakterli / boşluklu dosya adları, BOM'lu PHP dosyaları&#10;vendor ve node_modules klasörleri taranmaz."/>
                </StackPanel>
                <Ellipse x:Name="SumDot" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource Muted}"/>
                <StackPanel>
                    <TextBlock x:Name="SumTitle" Style="{StaticResource H2}" FontSize="16" Text="Taranıyor…"/>
                    <TextBlock x:Name="SumText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sonuçlar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0,24,8" Padding="6">
            <Grid>
                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Margin="10,10,10,0"/>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="List_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}" CornerRadius="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selection}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding LevelText, Mode=OneWay}" FontWeight="Bold" FontSize="11" Foreground="{Binding Level, Converter={StaticResource LevelBrush}, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Where, Mode=OneWay}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource AccentText}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Text}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="14" Text="Sorun bulunamadı. Proje Linux sunucuya taşınmaya hazır görünüyor."/>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnAgain" Style="{StaticResource Small}" Content="Yeniden tara" Click="Again_Click"/>
                    <Button x:Name="BtnCopy" Style="{StaticResource Small}" Content="Raporu kopyala" Click="Copy_Click"/>
                    <Button x:Name="BtnSave" Style="{StaticResource Small}" Content="Raporu kaydet…" Click="Save_Click"/>
                    <Button Style="{StaticResource Primary}" Content="Kapat" Click="Close_Click" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="Çift tıklayınca dosya düzenleyicide açılır."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
