<Window x:Class="DevNanotek.Views.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEVNANOTEK" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" Foreground="{DynamicResource Text}" FontFamily="{StaticResource FontUI}" FontSize="13.5"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="12" CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Başlık -->
            <Border Background="{DynamicResource Header}" CornerRadius="13,13,0,0" Padding="14,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10" Content="&#xE711;" Foreground="{DynamicResource HeaderMuted}"
                            Click="Close_Click" Margin="0" VerticalAlignment="Top" ToolTip="Kapat"/>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#232425" BorderBrush="#3A3B3D" BorderThickness="1" Margin="0,0,10,0">
                        <Viewbox Margin="2"><Path Data="{StaticResource BrandD}" Fill="#FAA41A" Width="64" Height="64"/></Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource FontBrand}" FontSize="19" Margin="0,0,0,-3" TextWrapping="NoWrap">
                            <Run Text="DEV" Foreground="#FAA41A"/><Run Text="NANOTEK" Foreground="{DynamicResource HeaderText}"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OverallDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OverallText" Foreground="{DynamicResource HeaderMuted}" FontSize="12" Text="…"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Servisler -->
            <StackPanel Margin="16,12,16,4">
                <TextBlock Style="{StaticResource Caption}" Text="SERVİSLER" Margin="0,0,0,4"/>
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Text="{Binding TitleWithVersion}" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                    <TextBlock Text="{Binding State}" FontSize="11.5" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Small}" Margin="0" Padding="10,3" VerticalAlignment="Center"
                                        Tag="{Binding}" Click="RowToggle_Click" Loaded="RowButton_Loaded"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Sürümler -->
            <StackPanel Margin="16,8,16,4">
                <TextBlock Style="{StaticResource Caption}" Text="AKTİF SÜRÜMLER" Margin="0,0,0,6"/>
                <ItemsControl x:Name="VersionsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}" Padding="8,2">
                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Text}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ModeText" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Eylemler -->
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12" Margin="0,8,0,0">
                <StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button x:Name="BtnStartAll" Style="{StaticResource Success}" Margin="0,0,4,0" Click="StartAll_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE768;" Margin="0,0,7,0"/><TextBlock Text="Tümünü başlat"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnStopAll" Style="{StaticResource Danger}" Margin="4,0,0,0" Click="StopAll_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE71A;" Margin="0,0,7,0"/><TextBlock Text="Tümünü durdur"/></StackPanel>
                        </Button>
                    </UniformGrid>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Programı aç" Margin="0" Click="Open_Click"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE774;" ToolTip="localhost" Click="Localhost_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE1D3;" ToolTip="phpMyAdmin" Click="Pma_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE8B7;" ToolTip="httpdocs klasörü" Click="Docs_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE756;" ToolTip="Terminal" Click="Terminal_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="BusyText" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
