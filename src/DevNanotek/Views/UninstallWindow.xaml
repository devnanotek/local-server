<Window x:Class="DevNanotek.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevNanotek.Views"
        Title="DEVNANOTEK'i Kaldır" Height="620" Width="680" MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        Icon="pack://application:,,,/Assets/devnanotek.ico" FontFamily="{StaticResource FontUI}" FontSize="13.5" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Header}" Padding="24,18">
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="10" Background="#232425" BorderBrush="#3A3B3D" BorderThickness="1" Margin="0,0,14,0">
                    <Viewbox Margin="3"><Path Data="{StaticResource BrandD}" Fill="#FAA41A" Width="64" Height="64"/></Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DEVNANOTEK'i kaldır" Foreground="{DynamicResource HeaderText}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource HeaderMuted}" FontSize="12.5" Margin="0,2,0,0"
                               Text="Servisler, hosts, PATH, otomatik başlatma, SSL sertifikası, güvenlik duvarı kuralları, kısayollar ve Denetim Masası kaydı kaldırılır."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,8">
                <StackPanel x:Name="ChoicePanel">
                    <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbKeep" GroupName="u" IsChecked="True" FontWeight="SemiBold" Content="Programı kaldır, projelerimi ve veritabanlarımı koru" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource OkBg}" CornerRadius="9" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="önerilen" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Ok}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="KeepInfo" Style="{StaticResource MutedText}" Margin="27,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10" BorderBrush="{DynamicResource Err}">
                        <StackPanel>
                            <RadioButton x:Name="RbAll" GroupName="u" FontWeight="SemiBold" Foreground="{DynamicResource Err}" Content="Her şeyi sil (projeler ve veritabanları dahil)" Checked="RbAll_Changed" Unchecked="RbAll_Changed"/>
                            <TextBlock x:Name="AllInfo" Style="{StaticResource MutedText}" Margin="27,4,0,0"/>
                            <CheckBox x:Name="CbDump" Margin="27,8,0,0" IsChecked="True" IsEnabled="False" Content="Silmeden önce veritabanlarının yedeğini (.sql) Masaüstüne kaydet"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="StepTitle" Style="{StaticResource H2}" FontSize="17" Text="Kaldırılıyor…"/>
                    <ProgressBar x:Name="Bar" Height="8" IsIndeterminate="True" Margin="0,10,0,6"/>
                    <local:ColoredLog x:Name="LogBox" Height="280" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Vazgeç" Click="Cancel_Click"/>
                <Button x:Name="BtnRun" Style="{StaticResource Danger}" Padding="18,8" Content="Kaldır" Click="Run_Click" Margin="0"/>
                <Button x:Name="BtnFinish" Style="{StaticResource Primary}" Padding="18,8" Content="Kapat" Click="Finish_Click" Visibility="Collapsed" Margin="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
