<local:ViewBase x:Class="DevNanotek.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DevNanotek.Views">
    <Grid Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Small}" Click="Wizard_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE945;" Margin="0,0,7,0"/><TextBlock Text="Kurulum sihirbazı"/></StackPanel>
                </Button>
                <Button x:Name="CheckBtn" Style="{StaticResource Small}" Click="RefreshCatalog_Click" Margin="0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE895;" Margin="0,0,7,0"/><TextBlock x:Name="CheckBtnText" Text="Şimdi denetle"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H1}" Text="Sürümler"/>
                    <local:InfoTip Margin="10,4,0,0" Text="Yeni PHP, MariaDB, MySQL, Node.js, Apache, Nginx ve phpMyAdmin sürümleri resmi kaynaklardan otomatik denetlenir (12 saatte bir). İstediğiniz kadar sürüm kurup tek tıkla geçebilirsiniz. ÖNERİLEN rozeti hosting uyumluluğu ve kararlılığa göre seçilir."/>
                </StackPanel>
                <TextBlock x:Name="CatalogInfo" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
        <!-- DEVNANOTEK'in kendi yeni sürümü (GitHub Releases) -->
        <Border x:Name="AppUpdateCard" Style="{StaticResource Card}" Background="{DynamicResource OkBg}" BorderBrush="{DynamicResource Ok}" Padding="16,12" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Link}" Content="Yenilikler" Click="AppNotes_Click" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource Primary}" Padding="12,5" Content="Şimdi güncelle" Click="AppUpdate_Click" Margin="0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Ok}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AppUpdateTitle" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="Program kendini günceller ve yeniden açılır; servisleriniz, projeleriniz ve ayarlarınız olduğu gibi kalır."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Güncellemeler -->
        <Border x:Name="UpdatesCard" Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Padding="16,12" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,5" Content="Tümünü güncelle" Click="UpdateAll_Click" Margin="0"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource AccentText}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="UpdatesTitle" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                </DockPanel>
                <ItemsControl x:Name="UpdatesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Güncelle" Tag="{Binding}" Click="UpdateOne_Click" Margin="0"/>
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Text}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Current, Mode=OneWay}" Foreground="{DynamicResource Muted}"/><Run Text="  →  "/><Run Text="{Binding New, Mode=OneWay}" Foreground="{DynamicResource Ok}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="2">
            <TabItem Header="PHP">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><local:ComponentListView x:Name="PhpList" Margin="0,0,8,0"/></ScrollViewer>
            </TabItem>
            <TabItem Header="Web sunucu">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><local:ComponentListView x:Name="WebList" Margin="0,0,8,0"/></ScrollViewer>
            </TabItem>
            <TabItem Header="Veritabanı">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><local:ComponentListView x:Name="DbList" Margin="0,0,8,0"/></ScrollViewer>
            </TabItem>
            <TabItem Header="Node.js">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><local:ComponentListView x:Name="NodeList" Margin="0,0,8,0"/></ScrollViewer>
            </TabItem>
            <TabItem Header="Araçlar">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><local:ComponentListView x:Name="ToolsList" Margin="0,0,8,0"/></ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</local:ViewBase>
